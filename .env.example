# FigureSmith / 图匠 — local development environment example
# Copy to `.env` for local use. Do not commit real secrets.

# ---------------------------------------------------------------------------
# OpenAI-compatible image / multimodal providers (desktop-first path)
# ---------------------------------------------------------------------------
# Used when calling OpenAI-compatible APIs for figure generation / SVG steps.
OPENAI_API_KEY=
# Optional custom OpenAI-compatible base URL (provider "custom")
# Example: https://api.example.com/v1
AUTOFIGURE_CUSTOM_BASE_URL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional multimodal retry tuning (SVG generation step)
# OPENROUTER_MULTIMODAL_RETRIES=3
# OPENROUTER_MULTIMODAL_RETRY_DELAY=1.5

# ---------------------------------------------------------------------------
# Local backend bind (Phase 1 development)
# Backend MUST bind to loopback only for desktop/local use.
# ---------------------------------------------------------------------------
FIGURESMITH_HOST=127.0.0.1
FIGURESMITH_PORT=8765

# Optional: override Python used by vendor job runner
# AUTOFIGURE_PYTHON=

# ---------------------------------------------------------------------------
# Cloud SAM API keys (optional; not the preferred offline desktop path)
# Kept for vendor compatibility during early phases. Phase 2 targets local models.
# ---------------------------------------------------------------------------
# ROBOFLOW_API_KEY=
# FAL_KEY=
# ROBOFLOW_API_URL=https://serverless.roboflow.com/sam3/concept_segment

# ---------------------------------------------------------------------------
# Phase 2 — local models + strict offline (desktop default)
# ---------------------------------------------------------------------------
# FigureSmith launcher defaults strict offline to ON.
FIGURESMITH_STRICT_OFFLINE=1
# FIGURESMITH_FORCE_LOCAL_SAM=1
# Optional override of app data root (defaults to %LOCALAPPDATA%\FigureSmith)
# FIGURESMITH_DATA_DIR=
# Local SAM3 checkpoint (required for local segmentation under strict offline)
# FIGURESMITH_SAM3_CHECKPOINT=%LOCALAPPDATA%\FigureSmith\models\sam3\sam3.pt
# Optional BPE vocab override
# FIGURESMITH_SAM3_BPE=
# Local RMBG-2.0 Transformers directory (config.json + weights)
# FIGURESMITH_RMBG_MODEL_PATH=%LOCALAPPDATA%\FigureSmith\models\rmbg-2.0
# Dev-only escape hatch to allow HF RMBG download (NOT for desktop/strict path)
# FIGURESMITH_ALLOW_HF_RMBG=0

# ---------------------------------------------------------------------------
# Phase 3 — model import manager
# ---------------------------------------------------------------------------
# Allow imports whose SHA-256 does not match resources/model-manifest.json pins.
# Default is reject-on-mismatch when pins are present. Leave unset/0 for release-like behavior.
# FIGURESMITH_ALLOW_UNPINNED_MODELS=0
# Optional SAM3 size gates (bytes). Defaults: min 1MiB, max 20GiB.
# FIGURESMITH_SAM3_MIN_BYTES=
# FIGURESMITH_SAM3_MAX_BYTES=
# Optional ZIP bomb guards for RMBG import
# FIGURESMITH_RMBG_ZIP_MAX_FILES=200
# FIGURESMITH_RMBG_ZIP_MAX_UNCOMPRESSED=
# Optional torch load probe during import (requires CUDA; default skipped)
# FIGURESMITH_MODEL_LOAD_PROBE=0

# ---------------------------------------------------------------------------
# Phase 4 — desktop session auth / sidecar
# ---------------------------------------------------------------------------
# Set automatically by the Tauri shell for the Python child process.
# Do NOT put a real token in a committed file. For local browser testing leave unset.
# FIGURESMITH_SESSION_TOKEN=
# Test/dev only: disable Bearer checks (pytest sets this via conftest).
# FIGURESMITH_DISABLE_AUTH=0
# Optional absolute path to Python used by the desktop sidecar.
# FIGURESMITH_PYTHON=
# Optional override when launching desktop outside the monorepo layout.
# FIGURESMITH_REPO_ROOT=

# ---------------------------------------------------------------------------
# Hugging Face token
# NOT required as the primary desktop path for FigureSmith.
# Phase 2 prefers local model packs over HF download.
# Only set if you intentionally use gated cloud/HF workflows during development
# with --no-strict-offline / FIGURESMITH_STRICT_OFFLINE=0.
# ---------------------------------------------------------------------------
# HF_TOKEN=
