# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# Virtual environments
.venv/
venv/
ENV/
env/

# Secrets / local env
.env
.env.local
*.pem

# Model weights and large binary artifacts (never commit)
# NOTE: do not use a bare "models/" rule — it would ignore the Python package
# apps/backend/figuresmith/models/. Only weight storage dirs are ignored.
/models/
resources/models/
**/*.pt
**/*.pth
**/*.onnx
**/*.safetensors
**/*.bin
**/*.ckpt
**/*.h5
**/*.pb
*.gguf

# Runtime outputs / caches
outputs/
uploads/
tmp/
temp/
.cache/
*.log

# IDE / editors
.idea/
.vscode/
*.swp
*.swo
*~

# OS junk
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Node (desktop)
node_modules/
apps/desktop/dist/

# Packaging / installers
*.msi
*.exe
*.dmg
*.AppImage
runtime-pack/
dist-desktop/
dist-runtime/

# Tauri / Rust build outputs
apps/desktop/src-tauri/target/

# Local model import staging
resources/models/
*.zip
!docs/**/*.zip
