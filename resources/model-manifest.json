{
  "$schema_comment": "FigureSmith model manifest — Phase 3 (import/pin policy; no weights in git).",
  "version": 3,
  "product": "FigureSmith",
  "phase": 3,
  "description": "Local model pack metadata, import targets, and optional official SHA-256 pins. Weights are never stored in the git repository.",
  "models": [
    {
      "id": "sam3",
      "display_name": "SAM3 Image",
      "role": "segmentation",
      "format": "pytorch_checkpoint",
      "default_relative_path": "models/sam3/sam3.pt",
      "env_var": "FIGURESMITH_SAM3_CHECKPOINT",
      "required_files": [
        "sam3.pt"
      ],
      "optional_files": [
        "bpe_simple_vocab_16e6.txt.gz",
        "metadata.json",
        "checksum.sha256"
      ],
      "load": {
        "entry": "build_sam3_image_model",
        "checkpoint_path_arg": "checkpoint_path",
        "load_from_HF": false,
        "notes": "Requires explicit local checkpoint_path and load_from_HF=False."
      },
      "import": {
        "accepts": [".pt", ".pth"],
        "staging": "models/.staging/sam3-<uuid>/",
        "destination": "models/sam3/",
        "writes": ["sam3.pt", "metadata.json", "checksum.sha256"]
      },
      "license_note": "Model weight license is separate from FigureSmith source license. Review the SAM3 provider terms before redistribution.",
      "sha256": null,
      "official_sha256": null,
      "files_sha256": {
        "sam3.pt": null
      },
      "import_ui": "phase3"
    },
    {
      "id": "rmbg-2.0",
      "display_name": "BRIA RMBG 2.0",
      "role": "background_removal",
      "format": "transformers_directory",
      "default_relative_path": "models/rmbg-2.0",
      "env_var": "FIGURESMITH_RMBG_MODEL_PATH",
      "required_files": [
        "config.json",
        "preprocessor_config.json",
        "model.safetensors"
      ],
      "optional_files": [
        "metadata.json",
        "checksum.sha256",
        "birefnet.py",
        "BiRefNet.py",
        "modeling_birefnet.py",
        "configuration_birefnet.py"
      ],
      "load": {
        "entry": "AutoModelForImageSegmentation.from_pretrained",
        "local_files_only": true,
        "trust_remote_code": true,
        "notes": "Forbids HF hub download fallback under strict offline. trust_remote_code may execute local pack Python — import only trusted sources."
      },
      "import": {
        "accepts": ["zip", "directory"],
        "staging": "models/.staging/rmbg-2.0-<uuid>/",
        "destination": "models/rmbg-2.0/",
        "zip_slip_guards": true,
        "max_files_default": 200,
        "max_uncompressed_default_gib": 8
      },
      "upstream_repo_hint": "briaai/RMBG-2.0",
      "license_note": "Gated / third-party model weights. Source code license ≠ weight license. Do not commit weights.",
      "sha256": null,
      "official_sha256": null,
      "files_sha256": {
        "model.safetensors": null
      },
      "import_ui": "phase3"
    }
  ],
  "pin_policy": {
    "description": "When official_sha256 / files_sha256 pins are non-null, mismatch rejects import unless FIGURESMITH_ALLOW_UNPINNED_MODELS=1.",
    "allow_unpinned_env": "FIGURESMITH_ALLOW_UNPINNED_MODELS",
    "null_pins_mean": "Import allowed; official_verified=false with warning."
  },
  "settings_file": {
    "app_data": "%LOCALAPPDATA%/FigureSmith/settings.json",
    "dev": ".figuresmith/settings.json",
    "example": {
      "models": {
        "sam3_checkpoint": "C:/path/to/sam3.pt",
        "sam3_bpe": null,
        "rmbg_model_path": "C:/path/to/RMBG-2.0"
      },
      "strict_offline": true
    }
  },
  "notes": [
    "Do not commit *.pt / *.safetensors / model directories.",
    "Phase 3 import uses staging + atomic promote; failed imports do not destroy verified packs.",
    "Source code license is independent of third-party model weight licenses.",
    "Primary import API accepts local absolute source_path only (no multi-GB multipart upload)."
  ]
}
